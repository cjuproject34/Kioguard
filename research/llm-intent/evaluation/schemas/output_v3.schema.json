{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kioguard.local/schemas/output_v3.schema.json",
  "title": "KioGuard intent output contract v3 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["requests", "fallback"],
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "target", "slots", "condition", "depends_on"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
          "intent": {
            "enum": [
              "SELECT", "MODIFY", "FULFILLMENT", "PAYMENT_METHOD", "RECEIPT",
              "BENEFIT_CONTROL", "NAVIGATE", "CANCEL", "GUIDE", "INFO",
              "UI_CONTROL", "HELP", "COMMIT_REQUEST", "RESET"
            ]
          },
          "target": {"type": ["string", "null"]},
          "slots": {"type": "object"},
          "condition": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state_key", "operator", "value"],
                "properties": {
                  "state_key": {"type": "string"},
                  "operator": {"enum": ["EQ", "NE", "IN", "NOT_IN"]},
                  "value": {}
                }
              }
            ]
          },
          "depends_on": {"type": ["string", "null"]}
        }
      }
    },
    "fallback": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "enum": [
                "ASK_SCREEN_TARGET", "ASK_GUIDANCE_NEED", "ASK_TARGET", "ASK_CONTEXT",
                "ASK_REFERENCE", "ASK_INPUT_REPEAT", "ASK_SCOPE", "OUT_OF_SCOPE", "NO_ACTION"
              ]
            },
            "field": {"type": "string"}
          }
        }
      ]
    }
  }
}
